{
  "name": "hono-dynamodb-closure-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bootstrap/server.ts",
    "start": "node --import tsx src/bootstrap/server.ts",
    "db:init": "node --import tsx src/infrastructure/dynamodb/init-tables.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/run-tests.ts",
    "test:integration": "node --import tsx scripts/run-tests.ts --integration",
    "check": "npm run check:style && npm run check:vite && npm run typecheck && npm test",
    "check:style": "node --import tsx scripts/check-no-destructuring.ts",
    "format": "vp fmt",
    "check:format": "vp fmt --check",
    "check:vite": "vp check"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1159.0",
    "@aws-sdk/lib-dynamodb": "^3.1159.0",
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "argon2": "^0.45.1",
    "electrodb": "^3.9.3",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "$vite"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
