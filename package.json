{
  "name": "hono-dynamodb-closure-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "db:init": "node --import tsx src/infrastructure/init-table.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "RUN_DYNAMODB_TESTS=1 node --import tsx --test test/dynamodb.integration.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1159.0",
    "@aws-sdk/lib-dynamodb": "^3.1159.0",
    "@hono/node-server": "^2.1.5",
    "argon2": "^0.45.1",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
